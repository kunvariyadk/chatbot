# ============================================
# APP CONFIGURATION
# ============================================
FLASK_ENV=production
FLASK_DEBUG=False
APP_VERSION=1.0.0

# ============================================
# SECRET KEY (generate a new strong one!)
# ============================================
SECRET_KEY=42cb4ebe4421b8f2b87f7c779e828eed2e90afea4a5db05e1ca0133f111bb203

# ============================================
# DATABASE (your live server database)
# ============================================
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/chatbot_panel
SQLALCHEMY_ECHO=False
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_POOL_PRE_PING=True
SQLALCHEMY_MAX_OVERFLOW=20

# ============================================
# SESSION
# ============================================
PERMANENT_SESSION_LIFETIME=2592000

# ============================================
# FILE STORAGE
# ============================================
BASE_DATA_FOLDER=/var/www/chatbot/data
USER_DATA_FOLDER=/var/www/chatbot/data/users
UPLOAD_FOLDER=/var/www/chatbot/data/uploads
MAX_CONTENT_LENGTH=52428800
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,svg
MAX_FILE_SIZE=2097152

# ============================================
# LOGGING
# ============================================
LOG_FILE=/var/log/chatbot/app.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================
# EMAIL CONFIGURATION (same, already configured)
# ============================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=kunvariya.dk@gmail.com
MAIL_PASSWORD=cwpctdztwwohcjhe
MAIL_FROM_ADDRESS=kunvariya.dk@gmail.com